# Build configuration for Raspberry Pi 5 + ROS 2 Jazzy
CONF_VERSION = "2"

MACHINE = "raspberrypi5"
DISTRO ?= "poky"
INIT_MANAGER = "systemd"
LICENSE_FLAGS_ACCEPTED = "synaptics-killswitch"

# Headless image: drop graphics/audio/radio stacks to keep the build small
DISTRO_FEATURES:remove = "x11 wayland opengl vulkan pulseaudio alsa bluetooth nfc 3g pcmcia"

# SSH server (dropbear) + passwordless root login for lab use.
# debug-tweaks is NOT suitable for a production image.
EXTRA_IMAGE_FEATURES ?= "debug-tweaks ssh-server-dropbear"

# Serial console on the 3-pin UART header (115200 8N1)
ENABLE_UART = "1"

# Parallelism: tuned for a 16 GB build VM (C++ ROS packages are memory hungry)
BB_NUMBER_THREADS ?= "10"
PARALLEL_MAKE ?= "-j 6"

PACKAGE_CLASSES ?= "package_ipk"
IMAGE_FSTYPES = "wic.bz2 wic.bmap"

DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"

# Disk space monitoring
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K"
